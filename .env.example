# ==============================================================================
# SignFlow Environment Variables Configuration
# ==============================================================================

# Application Base URL (used in email review links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 1. Administrator Account Credentials (Local / Simple Auth)
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@signflow.app
ADMIN_PASSWORD=AdminSignFlow2026!

# ------------------------------------------------------------------------------
# 2. Firebase Client SDK (Optional for cloud deployment)
# Obtain these from: Firebase Console -> Project Settings -> General -> Your apps -> Web app
# Note: If omitted, SignFlow automatically uses the resilient local disk persistence layer.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ------------------------------------------------------------------------------
# 3. Firebase Admin SDK (Server-Side Only - Trusted)
# Obtain from: Firebase Console -> Project Settings -> Service accounts -> Generate new private key
# ------------------------------------------------------------------------------
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# ------------------------------------------------------------------------------
# 4. Email Notifications (Resend)
# Obtain from: https://resend.com/api-keys
# Note: If omitted, notifications are safely logged to the server console.
# ------------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=SignFlow <notifications@signflow.app>

# ------------------------------------------------------------------------------
# 5. Telegram Notifications (Telegram Bot API)
# Bot Token: Message @BotFather on Telegram to create a bot
# Chat ID: Message your bot or query https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat ID
# Note: If omitted, notifications are safely logged to the server console.
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
